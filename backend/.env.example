# Copy to backend/.env and edit. NEVER commit real secrets.
ENV=development                      # development | test | production
SECRET_KEY=change-me-to-a-long-random-string-32+chars
DATABASE_URL=sqlite:///./data/app.db # production: postgresql+psycopg://user:pass@host:5432/msai
COOKIE_SECURE=false                  # true when served over HTTPS
CORS_ORIGINS=http://localhost:5173

# First-run Super Admin (used only when the users table is empty)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Super Admin

# Storage (local adapter implemented; shared_drive / s3 need approved credentials + an adapter)
STORAGE_BACKEND=local
STORAGE_ROOT=./data/storage
WORKSPACE_NAME=MysteryShop
MAX_UPLOAD_MB=25

# OCR (needs the Tesseract binary: https://github.com/tesseract-ocr/tesseract)
OCR_ENABLED=true
TESSERACT_CMD=

# AI provider: none | anthropic | openai_compatible
AI_PROVIDER=none
# Confidential PDFs are NEVER sent to an external provider unless this is true (set only after approval)
AI_ALLOW_EXTERNAL=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Private/in-house OpenAI-compatible endpoint (e.g. a self-hosted model)
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_API_KEY=
OPENAI_IS_INTERNAL=false

# Review policy: false = editors/submitters cannot take the QC decision on their own work
ALLOW_SELF_REVIEW=false

# After a RAW upload, let the AI editor correct spelling/grammar and send the edited PDF to QC
AI_EDIT_ON_UPLOAD=true

# Google Drive (read-only import). Create a service account, enable the Drive API, share the Drive folder with its e-mail.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
IMPORT_LOCAL_ROOT=./data/imports
MAX_IMPORT_MB=1024

# Automatic Drive sync (defaults; admins change them in the UI and the database value wins)
DRIVE_SCHEDULER_ENABLED=true
DRIVE_AUTO_SYNC=false
DRIVE_SYNC_INTERVAL_MINUTES=5
